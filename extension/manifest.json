{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.39",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "alarms", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_actionTitle__", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*; base-uri 'none'"
  }
}
